@page "/admin/add-parcel"
@layout MainLayout
@implements IDisposable
@using Arahk.ParcelPoint.Wasm.Models
@using System.Globalization
@inject NavigationManager Navigation

<PageTitle>เพิ่มพัสดุ</PageTitle>

<div class="add-parcel-page">
    <button type="button" class="back-home" @onclick="GoHome" aria-label="กลับหน้าหลัก">
        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> กลับหน้าหลัก
    </button>
    <h1 class="page-title">เพิ่มพัสดุ</h1>
    <div class="page-subtitle">บันทึกรายการพัสดุที่รับมาจากบริษัทขนส่ง</div>

    @if (_showSuccess)
    {
        <div class="banner banner-success">
            <i class="fa-solid fa-circle-check"></i>
            บันทึกเรียบร้อยแล้ว
        </div>
    }

    <ol class="step-indicator" aria-label="ขั้นตอนการเพิ่มพัสดุ">
        @for (var s = 1; s <= 3; s++)
        {
            var step = s;
            <li class="step-item @(s == _step ? "step-active" : null) @(s < _step ? "step-done" : null)">
                <button type="button"
                        class="step-dot"
                        disabled="@(s >= _step)"
                        @onclick="() => GoToStep(step)"
                        aria-label="@($"ขั้นตอน {s}: {StepName(s)}")"
                        aria-current="@(s == _step ? "step" : (bool?)null)">
                    @if (s < _step)
                    {
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                    }
                    else
                    {
                        @s
                    }
                </button>
                <span class="step-label">@StepName(s)</span>
            </li>
        }
    </ol>

    <form onsubmit="event.preventDefault(); return false;">
        @if (_step == 1)
        {
            <!-- พัสดุ -->
            <div class="section-card parcel-card step-panel">
                <div class="section-header">
                    <span class="section-icon"><i class="fa-solid fa-box" aria-hidden="true"></i></span>
                    <span>พัสดุ</span>
                </div>

                <div class="field">
                    <div class="field-label">เลขที่พัสดุ<span class="required">*</span></div>
                    <input class="field-input tracking-input @(ParcelNumberInvalid ? "field-input-invalid" : null)"
                           @bind="Model.ParcelNumber" @bind:event="oninput"
                           placeholder="เช่น 11000001213" />
                    <div class="tracking-reveal @(string.IsNullOrWhiteSpace(Model.ParcelNumber) ? null : "is-on")">
                        <div class="tracking-label">
                            <div class="barcode" aria-hidden="true"></div>
                            <div class="tracking-echo">@Model.ParcelNumber</div>
                        </div>
                    </div>
                    @if (ParcelNumberInvalid)
                    {
                        <div class="field-error"><i class="fa-solid fa-circle-exclamation"></i> กรุณากรอกเลขที่พัสดุ</div>
                    }
                    else if (DuplicateWarning != null)
                    {
                        <div class="field-warning"><i class="fa-solid fa-circle-info"></i> @DuplicateWarning</div>
                    }
                </div>

                <div class="field">
                    <div class="field-label">บริษัทขนส่ง</div>
                    <select class="field-input" @bind="Model.Provider">
                        <option value="">-- เลือกบริษัทขนส่ง --</option>
                        <option value="Kerry Express">Kerry Express</option>
                        <option value="Flash Express">Flash Express</option>
                        <option value="J&amp;T Express">J&amp;T Express</option>
                        <option value="SF Express">SF Express</option>
                        <option value="GPB Express">GPB Express</option>
                        <option value="Thai Post">ไปรษณีย์ไทย (Thai Post)</option>
                        <option value="Other">อื่น ๆ</option>
                    </select>
                </div>

                <div class="field">
                    <div class="field-label">สถานะ</div>
                    <div class="status-toggle">
                        <button type="button" class="status-option @StatusClass(ParcelStatuses.Ready)"
                                @onclick="() => SetStatus(ParcelStatuses.Ready)">
                            <i class="fa-solid fa-qrcode"></i> พร้อมรับ
                        </button>
                        <button type="button" class="status-option @StatusClass(ParcelStatuses.Pending)"
                                @onclick="() => SetStatus(ParcelStatuses.Pending)">
                            <i class="fa-solid fa-truck-ramp-box"></i> รอพรับ
                        </button>
                    </div>
                </div>
            </div>

            <!-- รายละเอียด -->
            <div class="section-card step-panel">
                <div class="section-header">
                    <span class="section-icon"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i></span>
                    <span>รายละเอียด</span>
                </div>

                <div class="field">
                    <div class="field-label">วันที่รับพัสดุ<span class="required">*</span></div>
                    <input type="date" class="field-input" @bind="Model.ReceivedDate" />
                    <div class="field-hint">
                        <i class="fa-regular fa-calendar"></i> บันทึกวันนี้: @TodayHint
                    </div>
                </div>

                <div class="field">
                    <div class="field-label">หมายเหตุ</div>
                    <textarea class="field-input" rows="3" @bind="Model.Notes"
                              placeholder="รายละเอียดเพิ่มเติม (ถ้ามี)"></textarea>
                </div>
            </div>
        }

        @if (_step == 2)
        {
            <!-- ผู้ส่ง -->
            <div class="section-card step-panel">
                <div class="section-header">
                    <span class="section-icon"><i class="fa-solid fa-user" aria-hidden="true"></i></span>
                    <span>ผู้ส่ง</span>
                </div>

                <div class="field">
                    <div class="field-label">ชื่อผู้ส่ง</div>
                    <input class="field-input" @bind="Model.SenderName" placeholder="ชื่อร้านค้า / ผู้ส่ง" />
                </div>

                <div class="field">
                    <div class="field-label">เบอร์โทรผู้ส่ง</div>
                    <input class="field-input" value="@Model.SenderPhone"
                           @onchange="e => Model.SenderPhone = FormatThaiPhone(e.Value?.ToString())"
                           inputmode="numeric" placeholder="08x-xxx-xxxx" />
                </div>
            </div>
        }

        @if (_step == 3)
        {
            <!-- ผู้รับ -->
            <div class="section-card step-panel">
                <div class="section-header">
                    <span class="section-icon"><i class="fa-solid fa-user-check" aria-hidden="true"></i></span>
                    <span>ผู้รับ</span>
                </div>

                <div class="field">
                    <div class="field-label">ชื่อผู้รับ<span class="required">*</span></div>
                    <input class="field-input @(ReceiverNameInvalid ? "field-input-invalid" : null)"
                           @bind="Model.ReceiverName" placeholder="ชื่อลูกบ้าน" />
                    @if (ReceiverNameInvalid)
                    {
                        <div class="field-error"><i class="fa-solid fa-circle-exclamation"></i> กรุณากรอกชื่อผู้รับ</div>
                    }
                </div>

                <div class="field-row-2">
                    <div class="field">
                        <div class="field-label">ห้อง / ยูนิต<span class="required">*</span></div>
                        <input class="field-input @(ReceiverUnitInvalid ? "field-input-invalid" : null)"
                               @bind="Model.ReceiverUnit" placeholder="เช่น 89/86-1203" />
                        @if (ReceiverUnitInvalid)
                        {
                            <div class="field-error"><i class="fa-solid fa-circle-exclamation"></i> กรุณากรอกห้อง/ยูนิต</div>
                        }
                    </div>
                    <div class="field">
                        <div class="field-label">เบอร์โทรผู้รับ</div>
                        <input class="field-input" value="@Model.ReceiverPhone"
                               @onchange="e => Model.ReceiverPhone = FormatThaiPhone(e.Value?.ToString())"
                               inputmode="numeric" placeholder="08x-xxx-xxxx" />
                    </div>
                </div>
            </div>
        }

        <div class="action-bar">
            @if (_step > 1)
            {
                <button class="btn btn-ghost" @onclick="GoBack">
                    <i class="fa-solid fa-arrow-left"></i>&nbsp; ย้อนกลับ
                </button>
            }
            @if (_step < 3)
            {
                <button class="btn btn-primary" @onclick="NextStep">
                    ถัดไป&nbsp;<i class="fa-solid fa-arrow-right"></i>
                </button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="SaveAsync">
                    <i class="fa-solid fa-floppy-disk"></i>&nbsp; บันทึกรายการ
                </button>
            }
            <button class="btn btn-secondary" @onclick="ResetForm">
                <i class="fa-solid fa-eraser"></i>&nbsp; ล้างข้อมูล
            </button>
        </div>
    </form>
</div>

@code {
    private Parcel Model { get; set; } = new();

    private int _step = 1;
    private bool _showSuccess;
    private bool _step1Tried;
    private bool _step3Tried;
    private CancellationTokenSource? _successTimeoutCts;

    // Tracking numbers already registered in the system (sample data).
    private static readonly string[] RegisteredTrackingNumbers =
    [
        "11000001213", "11000001291", "11000001288", "11000001287"
    ];

    private string TodayHint => DateTime.Today.ToString("D", new CultureInfo("th-TH"));

    private bool ParcelNumberInvalid => _step1Tried && string.IsNullOrWhiteSpace(Model.ParcelNumber);
    private bool ReceiverNameInvalid => _step3Tried && string.IsNullOrWhiteSpace(Model.ReceiverName);
    private bool ReceiverUnitInvalid => _step3Tried && string.IsNullOrWhiteSpace(Model.ReceiverUnit);

    private string? DuplicateWarning =>
        string.IsNullOrWhiteSpace(Model.ParcelNumber) || !RegisteredTrackingNumbers.Contains(Model.ParcelNumber.Trim())
            ? null
            : $"เลขที่พัสดุนี้มีพัสดุลงทะเบียนอยู่แล้ว (ข้อมูลตัวอย่าง) — สามารถบันทึกรายการนี้ได้";

    private static string StepName(int step) => step switch
    {
        1 => "พัสดุ",
        2 => "ผู้ส่ง",
        3 => "ผู้รับ",
        _ => string.Empty
    };

    private string StatusClass(string status)
    {
        if (Model.Status != status)
        {
            return string.Empty;
        }

        return status == ParcelStatuses.Ready
            ? "status-option-active-ready"
            : "status-option-active-pending";
    }

    private void SetStatus(string status) => Model.Status = status;

    private void GoHome() => Navigation.NavigateTo("/");

    // Advances only forward and only after the current step is complete.
    private void NextStep()
    {
        if (_step == 1 && string.IsNullOrWhiteSpace(Model.ParcelNumber))
        {
            _step1Tried = true;
            return;
        }

        _step = Math.Min(3, _step + 1);
    }

    private void GoBack() => _step = Math.Max(1, _step - 1);

    // Jump back to an earlier step; forward jumps are intentionally blocked.
    private void GoToStep(int step)
    {
        if (step < _step)
        {
            _step = step;
        }
    }

    // Formats Thai mobile numbers while typing: keeps digits only, groups as 08x-xxx-xxxx.
    private static string FormatThaiPhone(string? value)
    {
        var digits = string.Concat((value ?? string.Empty).Where(char.IsDigit));
        if (digits.Length is <= 3)
        {
            return digits;
        }

        if (digits.Length is <= 7)
        {
            return $"{digits[..3]}-{digits[3..]}";
        }

        return $"{digits[..3]}-{digits[3..7]}-{digits[7..]}";
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Model.ParcelNumber))
        {
            _step1Tried = true;
            _step = 1;
            _showSuccess = false;
            return;
        }

        _step3Tried = true;
        if (string.IsNullOrWhiteSpace(Model.ReceiverName)
            || string.IsNullOrWhiteSpace(Model.ReceiverUnit))
        {
            _showSuccess = false;
            return;
        }

        _showSuccess = true;
        ResetForm();

        // Auto-dismiss the success banner; a new save (or disposal) cancels it.
        _successTimeoutCts?.Cancel();
        _successTimeoutCts = new CancellationTokenSource();
        var token = _successTimeoutCts.Token;

        try
        {
            await Task.Delay(3500, token);
        }
        catch (TaskCanceledException)
        {
            // Cancelled by a newer save (or disposal) — leave state untouched.
            return;
        }

        if (_showSuccess)
        {
            _showSuccess = false;
        }
    }

    private void ResetForm()
    {
        Model = new Parcel { ReceivedDate = DateTime.Today };
        _step1Tried = false;
        _step3Tried = false;
        _step = 1;
    }

    public void Dispose()
    {
        // Cancels any pending success-timeout so it cannot touch state after unmount.
        _successTimeoutCts?.Cancel();
        _successTimeoutCts?.Dispose();
    }
}
