@page "/"
@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>

<style>
    #location-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 0 0 1rem 0;
        border-radius: .3rem;
        background-color: lightseagreen;
        width: 100%;
        max-width: 480px;
        overflow: hidden;
    }

    .location-main {
        display: flex;
        align-items: center;
        flex: 1 1 0;
        min-width: 0;
        font-size: .8rem;
    }

    .location-label {
        flex: 0 0 auto;
        padding: 1rem;
        background-color: #00A896;
        color: white;
        white-space: nowrap;
    }

    .location-value {
        flex: 1 1 0;
        min-width: 0;
        padding-left: 1rem;
        text-align: center;
        font-size: 1rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .location-icon {
        flex: 0 0 auto;
        color: white;
        padding-right: 1rem;
    }

    #summary-section {
        display: flex;
        gap: 1rem;
        width: 100%;
        max-width: 480px;
    }

    .summary-items {
        display: flex;
        flex-direction: column;
        flex: 1 1 0;
        min-width: 0;
        align-items: center;
        justify-content: center;
        background-color: white;
        border-radius: .4rem;
        padding: .8rem 0;
        position: relative;
        overflow: hidden;
    }

    .summary-value {
        font-size: clamp(1.4rem, 6.5vw, 2.3rem);
        font-weight: bolder;
        margin: 1rem 0 .2rem 0;
        line-height: 1.1;
        white-space: nowrap;
    }

    .fab-add {
        position: fixed;
        right: 1rem;
        bottom: 4.25rem;
        z-index: 5;
        width: 3.25rem;
        height: 3.25rem;
        border-radius: 50%;
        border: none;
        color: white;
        font-size: 1.4rem;
        background: linear-gradient(180deg, #00BFA5 0%, #00A896 60%, #008080 100%);
        box-shadow: 0 4px 14px rgba(0, 60, 55, .35);
        cursor: pointer;
        transition: transform .08s ease, box-shadow .08s ease;
    }

    .fab-add:active {
        transform: translateY(1px);
        box-shadow: 0 2px 6px rgba(0, 60, 55, .35);
    }
</style>

<div id="location-section">
    <div class="location-main">
        <div class="location-label">
            สถานที่
        </div>
        <div class="location-value">89/86 Groove Ville</div>
    </div>
    <i class="fa-solid fa-chevron-down location-icon"></i>
</div>

<div style="padding-bottom: .6rem; color: #B2E2E2; font-size: .8rem">Summary</div>
<div id="summary-section">
    <div class="summary-items" style="border-bottom: solid .3rem lightgreen;">
        <div style="position: absolute; top: .4rem; left: .4rem; color: dimgray">
            <i class="fa-solid fa-people-carry-box" style="color: green"></i>
        </div>
        <span class="summary-value">19</span>
        <div style="color: gray; font-size: .9rem;">
            พร้อมรับ
        </div>
    </div>
    <div class="summary-items" style="border-bottom: solid .3rem blue;">
        <div style="position: absolute; top: .4rem; left: .4rem; color: dimgray">
            <i class="fa-solid fa-truck-ramp-box" style="color: blue"></i>
        </div>
        <span class="summary-value">5</span>
        <div style="color: gray; font-size: .9rem;">
            รอรับ
        </div>
    </div>
    <div class="summary-items" style="border-bottom: solid .3rem #FF8A65;">
        <div style="position: absolute; top: .4rem; left: .4rem; color: dimgray">
            <i class="fa-solid fa-boxes-stacked" style="color: #FF8A65"></i>
        </div>
        <span class="summary-value">24</span>
        <div style="color: gray; font-size: .9rem;">
            ทั้งหมด
        </div>
    </div>
</div>

<div style="padding-bottom: .6rem; color: #B2E2E2; font-size: .8rem; margin-top: 1rem;">List</div>
<div style="max-width: 480px">
    <PacelListItem State="Ready" ReceiveDate="new DateTime(2026,11,22)" ParcelNumber="11000001213"
                   Provider="Flash Express"/>
    <PacelListItem State="Pending" ReceiveDate="new DateTime(2026,11,12)" ParcelNumber="11000001291"
                   Provider="Kerry Express"/>
    <PacelListItem State="Ready" ReceiveDate="new DateTime(2026,11,10)" ParcelNumber="11000001288"
                   Provider="Kerry Express"/>
    <PacelListItem State="Pending" ReceiveDate="new DateTime(2026,11,10)" ParcelNumber="11000001287"
                   Provider="Kerry Express"/>
</div>

<button type="button" class="fab-add" aria-label="เพิ่มพัสดุ"
        @onclick='() => Navigation.NavigateTo("/admin/add-parcel")'>
    <i class="fa-solid fa-plus"></i>
</button>
