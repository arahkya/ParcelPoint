@using System.Globalization

<div class="list-item-container" role="listitem">
    <div class="parcel-card" style="border-left: solid 5px @(IsReady ? "var(--status-ready)" : "var(--status-pending)");">
        <!-- ข้อมูลหลักด้านซ้าย -->
        <div class="info-section">
            <div class="date-text">@ReceiveDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</div>
            <div class="id-text">@ParcelNumber</div>
            <div class="provider-text">@Provider</div>
            <div class="status-text @(IsReady ? "status-ready" : "status-pending")">
                @(IsReady ? "พร้อมรับ" : "รอรับ")
            </div>
        </div>

        <!-- QR Code ด้านขวา -->
        <div class="qr-section">
            @if (IsReady)
            {
                <i class="fa-solid fa-qrcode" style="font-size: 2.5rem; color: var(--status-ready);" aria-hidden="true"></i>
            }
            else
            {
                <i class="fa-solid fa-truck-ramp-box" style="font-size: 2rem; color: var(--status-pending);" aria-hidden="true"></i>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public DateTime ReceiveDate { get; set; } = DateTime.MinValue;
    [Parameter] public string ParcelNumber { get; set; } = string.Empty;
    [Parameter] public string Provider { get; set; } = string.Empty;
    [Parameter] public string State { get; set; } = string.Empty;

    private bool IsReady => State == "Ready";
}
