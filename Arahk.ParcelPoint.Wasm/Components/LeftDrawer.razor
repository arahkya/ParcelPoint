<style>
    #backdrop {
        position: fixed;
        top: 0;
        left: 0;
        background-color: black;
        opacity: .8;
        height: 100vh;
        width: 100%;
    }

    .show {
        animation: fadeIn .5s ease-in-out forwards;      
        z-index: 999;
    }

    .close {
        animation: fadeOut .5s ease-in-out forwards;        
    }
    
    .container-show {
        animation: slideIn .5s ease-in-out forwards;
        
    }

    .container-close {        
        animation: slideOut .2s ease-in-out forwards;
    }

    #container {
        width: 90%;
        max-width: 400px;
        min-width: 300px;
        height: 100vh;
        background-color: white;
        z-index: 1000;
        position: fixed;
        top: 0;
        left: 0;
    }

    #CloseButton {
        background-color: white;
        border-radius: 2rem;
        height: 2rem;
        width: 2rem;
        padding: .3rem .4rem .3rem .3rem;
        position: absolute;
        bottom: 1rem;
        right: -1.3rem;
    }

    #drawer-header {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: 1.1rem 1rem;
        font-size: .95rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #00A896;
        border-bottom: 1px solid #e8e8e8;
    }

    #drawer-nav {
        display: flex;
        flex-direction: column;
        gap: .3rem;
        padding: .8rem;
    }

    .drawer-link {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: .8rem 1rem;
        border-radius: .5rem;
        color: #333;
        text-decoration: none;
        font-size: 1rem;
        transition: background-color .15s ease, color .15s ease;
    }

    .drawer-link i {
        width: 1.5rem;
        text-align: center;
        color: #00A896;
    }

    .drawer-link:hover {
        background-color: #e8f5f3;
        color: #008080;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;            
        }
        to {
            opacity: .7;            
        }
    }

    @@keyframes fadeOut {
        from {
            opacity: .7;
            z-index: 999;
        }
        to {
            opacity: 0;
            z-index: -999;
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-100%);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes slideOut {
        from {
            opacity: 1;
            transform: translateX(0);
        }
        to {
            opacity: 0;
            transform: translateX(-100%);
        }      
    }

</style>

<div id="backdrop" class="@(Toggle ? "show" : "close")" @onclick="TapBackdrop"></div>
<div id="container" class="@(Toggle ? "container-show" : "container-close")">
    <div id="drawer-header">
        <i class="fa-solid fa-bars-staggered"></i>
        เมนู
    </div>
    <nav id="drawer-nav">
        <a href="/" class="drawer-link" @onclick:preventDefault @onclick='() => NavigateAndCloseAsync("/")'>
            <i class="fa-solid fa-house"></i>
            หน้าแรก
        </a>
        <a href="/admin/add-parcel" class="drawer-link" @onclick:preventDefault @onclick='() => NavigateAndCloseAsync("/admin/add-parcel")'>
            <i class="fa-solid fa-box-plus"></i>
            เพิ่มพัสดุ
        </a>
    </nav>
    <div id="CloseButton" @onclick="TapBackdrop">
        <i class="fa-solid fa-circle-arrow-left" style="font-size: 2rem;"></i>
    </div>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    [Parameter] public bool Toggle { get; set; }

    [Parameter] public EventCallback<bool> IsToggleChanged { get; set; }

    private async Task TapBackdrop()
    {
        Toggle = false;

        await IsToggleChanged.InvokeAsync(Toggle);
    }

    private async Task NavigateAndCloseAsync(string url)
    {
        Toggle = false;

        await IsToggleChanged.InvokeAsync(Toggle);
        Navigation.NavigateTo(url);
    }

}