<div class="backdrop @(Toggle ? "show" : "close")" @onclick="TapBackdrop"></div>
<div class="drawer @(Toggle ? "drawer-show" : "drawer-close")">
    <div class="drawer-header">
        <i class="fa-solid fa-bars-staggered"></i>
        เมนู
        <button type="button" class="close-button" @onclick="TapBackdrop" aria-label="ปิดเมนู">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
    </div>
    <nav class="drawer-nav">
        <a href="/admin/add-parcel" class="drawer-link" @onclick:preventDefault @onclick='() => NavigateAndCloseAsync("/admin/add-parcel")'>
            <i class="fa-solid fa-box-plus" aria-hidden="true"></i>
            เพิ่มพัสดุ
        </a>
    </nav>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    [Parameter] public bool Toggle { get; set; }

    [Parameter] public EventCallback<bool> IsToggleChanged { get; set; }

    private async Task TapBackdrop()
    {
        Toggle = false;

        await IsToggleChanged.InvokeAsync(Toggle);
    }

    private async Task NavigateAndCloseAsync(string url)
    {
        Toggle = false;

        await IsToggleChanged.InvokeAsync(Toggle);
        Navigation.NavigateTo(url);
    }

}
