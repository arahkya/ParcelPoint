@inherits LayoutComponentBase
@inject NavigationManager Navigation

<LeftDrawer Toggle="@_openLeftDrawer" IsToggleChanged="@OnLeftDrawerToggled" />

<div id="main-container">
    <div id="greeting">
        <button type="button" class="greeting-burger" aria-label="เปิดเมนู" @onclick="() => OnLeftDrawerToggled(true)">
            <!-- แบบก้อนทึบ (Filled Version) -->
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
                 aria-hidden="true" focusable="false">
                <rect x="4" y="6" width="20" height="3" rx="1" fill="#FFFFFF"/>
                <rect x="4" y="13" width="20" height="3" rx="1" fill="#FFFFFF"/>
                <rect x="4" y="20" width="20" height="3" rx="1" fill="#FFFFFF"/>
            </svg>
        </button>
        <div class="greeting-title">
            ParcelPoint
        </div>
        <div class="greeting-sub">
            Greeting, Arahk
        </div>
    </div>
    <div id="main-page">
        @Body
    </div>
    <nav id="bottom-nav" aria-label="เมนูหลัก">
        <a class="bottom-nav-item @(IsActive("/") ? "active" : null)" href="/"
           aria-current="@(IsActive("/") ? "page" : "false")">
            Active
        </a>
        <a class="bottom-nav-item @(IsActive("/history") ? "active" : null)" href="/history"
           aria-current="@(IsActive("/history") ? "page" : "false")">
            History
        </a>
        <a class="bottom-nav-item @(IsActive("/profile") ? "active" : null)" href="/profile"
           aria-current="@(IsActive("/profile") ? "page" : "false")">
            Profile
        </a>
    </nav>
</div>

@code
{
    private bool _openLeftDrawer = false;

    private void OnLeftDrawerToggled(bool isOpen) => _openLeftDrawer = isOpen;

    // Resolve the current path relative to the app's base URL, always
    // normalised to start with "/" (e.g. "/" or "/history").
    private string CurrentPath
    {
        get
        {
            var uri = Navigation.Uri;
            var baseUri = Navigation.BaseUri;
            var path = (uri != null && baseUri != null && uri.StartsWith(baseUri, StringComparison.Ordinal))
                ? uri.Substring(baseUri.Length)
                : (uri ?? "/");
            if (string.IsNullOrEmpty(path))
                return "/";
            return path.StartsWith("/", StringComparison.Ordinal) ? path : "/" + path;
        }
    }

    private bool IsActive(string path) => CurrentPath == path;
}
